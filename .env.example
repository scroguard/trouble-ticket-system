# Copy to .env and adjust.  `docker compose up -d --build`

# --- Application --------------------------------------------------------------
APP_BASE_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
LOG_LEVEL=INFO
WEB_PORT=8000

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=tickets
POSTGRES_USER=tickets
POSTGRES_PASSWORD=change-me
# Host "db" is the compose service name. Driver: psycopg (v3).
DATABASE_URL=postgresql+psycopg://tickets:change-me@db:5432/tickets

# --- IMAP (inbound mail polled by the worker) ------------------------------------
# Implicit TLS:  IMAP_PORT=993  IMAP_USE_SSL=true   IMAP_USE_STARTTLS=false
# STARTTLS:      IMAP_PORT=143  IMAP_USE_SSL=false  IMAP_USE_STARTTLS=true
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USE_SSL=true
IMAP_USE_STARTTLS=false
IMAP_USER=support@example.com
IMAP_PASSWORD=change-me
IMAP_MAILBOX=INBOX
IMAP_POLL_INTERVAL=60
IMAP_TIMEOUT=30
IMAP_BATCH_SIZE=50
IMAP_MAX_FAILURES=3

# --- SMTP (outbound replies & notifications) --------------------------------------
# STARTTLS:      SMTP_PORT=587  SMTP_USE_SSL=false  SMTP_USE_STARTTLS=true
# Implicit TLS:  SMTP_PORT=465  SMTP_USE_SSL=true   SMTP_USE_STARTTLS=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USE_STARTTLS=true
SMTP_USER=support@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_ADDRESS=support@example.com
SMTP_FROM_NAME=Example Support
SMTP_TIMEOUT=30

# --- Retry policy for IMAP & SMTP (exponential backoff with jitter) -----------------
EMAIL_MAX_RETRIES=4
EMAIL_RETRY_BASE_DELAY=2
EMAIL_RETRY_MAX_DELAY=60

# --- Priority ---------------------------------------------------------------
# New tickets default to "medium". When enabled, urgency keywords escalate them:
# URGENT/EMERGENCY/CRITICAL/OUTAGE/"server down" in the subject -> urgent;
# the same words in the body, or ASAP/DOWN/IMPORTANT in the subject -> high.
PRIORITY_ESCALATION_ENABLED=true

# --- Auth -------------------------------------------------------------------
SESSION_TTL_HOURS=12
# Leave unset to use Secure cookies automatically when APP_BASE_URL is https://
# SESSION_COOKIE_SECURE=true
# Failed-login limits: per account+IP and per IP within LOGIN_LOCKOUT_MINUTES,
# plus a per-account cap across all IPs per hour. Admins can clear them (unlock).
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=50
# Behind a reverse proxy, list its IP(s) so the real client IP (X-Forwarded-For)
# is used for rate limiting. Read directly by uvicorn.
# FORWARDED_ALLOW_IPS=172.18.0.10
# Extra origins (besides APP_BASE_URL) allowed to send POST/PATCH from a browser.
TRUSTED_ORIGINS=

# --- Staff alerts ----------------------------------------------------------------
# New tickets alert all active staff (agents and admins). A customer reply alerts the
# ticket's assignee, or all staff if it's unassigned; bursts within the cooldown are
# coalesced (a new alert is sent as soon as an agent has answered in between).
CUSTOMER_REPLY_ALERTS=true
CUSTOMER_REPLY_ALERT_COOLDOWN_MINUTES=5
# Mail-loop breaker: at most this many "we received your request" emails per address
# per hour (protects against auto-responders that ignore the standard headers).
ACK_MAX_PER_ADDRESS_PER_HOUR=3

# --- Customer portal (APP_BASE_URL/portal/) ----------------------------------------
# Customers sign in with an emailed one-time link and can open, follow, reply to
# and close their own tickets. Set to false to switch the portal off entirely.
PORTAL_ENABLED=true
PORTAL_LINK_MINUTES=15
PORTAL_SESSION_DAYS=14
PORTAL_LINKS_PER_HOUR=5
PORTAL_LINKS_PER_IP_PER_HOUR=20
PORTAL_TICKETS_PER_HOUR=10
PORTAL_REPLIES_PER_HOUR=30
PORTAL_MAX_FILES=5

# --- Reply delivery retries (worker) -----------------------------------------------
# Failed agent replies are retried with exponential backoff, then marked failed
# for good (agents can hit "resend").
REPLY_MAX_ATTEMPTS=6
REPLY_RETRY_BASE_SECONDS=300
REPLY_PENDING_TIMEOUT_SECONDS=600

# --- Attachments ------------------------------------------------------------
ATTACHMENT_DIR=/data/attachments
ATTACHMENT_MAX_BYTES=20971520

# --- Local testing with the bundled GreenMail server (profile "mailtest") -------------
